#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT="$(dirname -- "$SCRIPT_DIR")"
ROOT="${TRUE_FAMILY_HA_HARNESS_ROOT:-/data/.cache/opencode-tmp/opencode/true-family-ha-2026.7.4}"
PYTHON="$ROOT/venv/bin/python"
UV="$ROOT/bin/uv"

test "$(node --version)" = "v20.19.2" || {
  printf '%s\n' "Node.js 20.19.2 is required" >&2
  exit 1
}

env -i \
  PATH="/usr/bin:/bin" \
  HOME="$ROOT/home" \
  LANG="C.UTF-8" \
  LC_ALL="C.UTF-8" \
  XDG_CACHE_HOME="$ROOT/xdg/cache" \
  UV_CACHE_DIR="$ROOT/cache/uv" \
  UV_MANAGED_PYTHON="1" \
  UV_NO_ENV_FILE="1" \
  UV_NO_SYSTEM_CONFIG="1" \
  UV_PROJECT_ENVIRONMENT="$ROOT/venv" \
  UV_PYTHON_INSTALL_DIR="$ROOT/python" \
  "$UV" lock --check --offline --directory "$PROJECT"

"$PROJECT/scripts/ha-test-harness" -q

"$PYTHON" "$PROJECT/scripts/release_identity.py" check --require-bound

env PYTHONPYCACHEPREFIX="$ROOT/cache/pycache" \
  "$PYTHON" -m unittest discover \
  -s "$PROJECT/tests" \
  -p "test_*.py"

env PYTHONPYCACHEPREFIX="$ROOT/cache/pycache" \
  "$PYTHON" -m compileall -q \
  "$PROJECT/custom_components/true_family" \
  "$PROJECT/scripts/release_identity.py" \
  "$PROJECT/true_family_journal/server.py" \
  "$PROJECT/tests"

node --check "$PROJECT/frontend/replacement-wizard.js"
node --check \
  "$PROJECT/custom_components/true_family/probe/true_family_brt_probe.mjs"
node --test "$PROJECT/tests/js/test_physical_probe.mjs"
bash -n "$PROJECT/scripts/pass-b1-broker"
node --check "$PROJECT/tests/js/test_physical_probe_broker_runtime.mjs"
node --check "$PROJECT/tests/js/verify_physical_probe_broker_runtime.mjs"
node --test "$PROJECT/tests/js/test_physical_probe_broker_runtime.mjs"
env -i PATH="$PATH" "$PROJECT/scripts/pass-b1-broker" --shell-self-check
env -i PATH="$PATH" "$PROJECT/scripts/pass-b1-broker" --self-check

jq empty \
  "$PROJECT/custom_components/true_family/manifest.json" \
  "$PROJECT/custom_components/true_family/probe/true_family_brt_probe.manifest.json" \
  "$PROJECT/custom_components/true_family/strings.json" \
  "$PROJECT/custom_components/true_family/translations/en.json" \
  "$PROJECT/hacs.json" \
  "$PROJECT/release/identity.json" \
  "$PROJECT/tests/fixtures/physical_probe_pass_b1_manifest.json" \
  "$PROJECT/tests/fixtures/physical_probe_preflight_vectors.json" \
  "$PROJECT/tests/fixtures/physical_probe_vectors.json"

yq '.' \
  "$PROJECT/.github/workflows/pass-b1-broker.yaml" \
  "$PROJECT/.github/workflows/release-app.yaml" \
  "$PROJECT/.github/workflows/validate-integration.yaml" \
  "$PROJECT/repository.yaml" \
  "$PROJECT/true_family_journal/config.yaml" \
  >/dev/null
